    <sys:String x:Key="Screens.Editor.Error.VideosDoneTooMany">Videos done can't be more than the number of videos.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.Estimate">Estimated hours must be more than 0.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.Adjust">Remaining must be 0 hours or more.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.Start">Pick a start date.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.DeadlineMissing">Pick a deadline, or tick “No deadline”.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.DeadlineBeforeStart">The deadline must be on or after the start date.</sys:String>

    <!-- FreeTime -->
    <sys:String x:Key="Screens.FreeTime.Title">Free time</sys:String>
    <sys:String x:Key="Screens.FreeTime.Intro">How much time can you study each day? Mozakra splits it across your plans.</sys:String>
    <sys:String x:Key="Screens.FreeTime.Presets">Start from:</sys:String>
    <sys:String x:Key="Screens.FreeTime.Preset.Student">Student</sys:String>
    <sys:String x:Key="Screens.FreeTime.Preset.Employee">Employee</sys:String>
    <sys:String x:Key="Screens.FreeTime.Preset.Freelancer">Freelancer</sys:String>
    <sys:String x:Key="Screens.FreeTime.PresetsHint">Fills the week; then adjust it.</sys:String>
    <sys:String x:Key="Screens.FreeTime.MinutesHeader">Minutes</sys:String>
    <sys:String x:Key="Screens.FreeTime.Reminder">Reminder</sys:String>
    <sys:String x:Key="Screens.FreeTime.ComingSoon">(coming soon)</sys:String>
    <sys:String x:Key="Screens.FreeTime.ReminderHint">Reminder time like 20:30 (reminders arrive in v1.1)</sys:String>
    <sys:String x:Key="Screens.FreeTime.WeeklyTotal">Weekly total: {0}</sys:String>
    <sys:String x:Key="Screens.FreeTime.Exceptions">Exceptions</sys:String>
    <sys:String x:Key="Screens.FreeTime.ExceptionsHint">Vacation, a free day or a busy day. When they overlap, the newest one counts.</sys:String>
    <sys:String x:Key="Screens.FreeTime.AddException">+ Add a range</sys:String>
    <sys:String x:Key="Screens.FreeTime.NoExceptions">No exceptions.</sys:String>
