    <sys:String x:Key="Screens.Settings.License">Free and open source, MIT license.</sys:String>

    <!-- Onboarding -->
    <sys:String x:Key="Screens.Onboarding.Title">Welcome to Mozakra</sys:String>
    <sys:String x:Key="Screens.Onboarding.Welcome">Let's set up Mozakra in a minute</sys:String>
    <sys:String x:Key="Screens.Onboarding.StepFormat">Step {0} of {1}</sys:String>
    <sys:String x:Key="Screens.Onboarding.LanguageTitle">Pick your language</sys:String>
    <sys:String x:Key="Screens.Onboarding.LanguageHint">You can change it later in Settings.</sys:String>
    <sys:String x:Key="Screens.Onboarding.FreeTimeTitle">Your free time</sys:String>
    <sys:String x:Key="Screens.Onboarding.FreeTimeHint">Pick what fits you best, then adjust the minutes per day.</sys:String>
    <sys:String x:Key="Screens.Onboarding.PlanTitle">Your first plan</sys:String>
    <sys:String x:Key="Screens.Onboarding.PlanHint">A course you're studying or a project you're building. You can skip and add it later.</sys:String>
    <sys:String x:Key="Screens.Onboarding.SkipPlan">Skip</sys:String>
    <sys:String x:Key="Screens.Onboarding.Finish">Let's go</sys:String>
