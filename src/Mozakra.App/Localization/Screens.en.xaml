    <sys:String x:Key="Screens.Health.Overdue">Overdue</sys:String>
    <sys:String x:Key="Screens.Health.Completed">Completed 🎉</sys:String>
    <sys:String x:Key="Screens.Health.Waiting">Waiting</sys:String>
    <sys:String x:Key="Screens.Health.NoDeadline">No deadline</sys:String>

    <!-- Plans -->
    <sys:String x:Key="Screens.Plans.Title">My plans</sys:String>
    <sys:String x:Key="Screens.Plans.Add">+ New plan</sys:String>
    <sys:String x:Key="Screens.Plans.FreeTime">Free time</sys:String>
    <sys:String x:Key="Screens.Plans.Settings">Settings</sys:String>
    <sys:String x:Key="Screens.Plans.Archive">Archive</sys:String>
    <sys:String x:Key="Screens.Plans.Unarchive">Unarchive</sys:String>
    <sys:String x:Key="Screens.Plans.Archived">Archived</sys:String>
