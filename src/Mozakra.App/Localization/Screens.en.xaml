    <sys:String x:Key="Screens.Editor.Preview.Tight">⚠ tight</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.Impossible">⚠ Needs {0}, you have {1} before the deadline → earliest realistic date: {2}</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.Overdue">⚠ The deadline has passed → earliest realistic date: {0}</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.Completed">This plan is already done 🎉</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.NoFreeTime">⚠ No free time set. Add free time to see a forecast.</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.Archived">This plan is archived.</sys:String>
    <sys:String x:Key="Screens.Editor.Error.Name">Enter a name.</sys:String>
