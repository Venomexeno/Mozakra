    <!-- Editor -->
    <sys:String x:Key="Screens.Editor.NewTitle">New plan</sys:String>
    <sys:String x:Key="Screens.Editor.EditTitle">Edit plan</sys:String>
    <sys:String x:Key="Screens.Editor.Kind">Kind</sys:String>
    <sys:String x:Key="Screens.Editor.Name">Name</sys:String>
    <sys:String x:Key="Screens.Editor.Videos">Number of videos</sys:String>
    <sys:String x:Key="Screens.Editor.Duration">Total duration</sys:String>
    <sys:String x:Key="Screens.Editor.HoursUnit">h</sys:String>
    <sys:String x:Key="Screens.Editor.MinutesUnit">min</sys:String>
