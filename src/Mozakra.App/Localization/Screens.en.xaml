    <sys:String x:Key="Screens.Editor.StartDate">Start date</sys:String>
    <sys:String x:Key="Screens.Editor.Deadline">Deadline</sys:String>
    <sys:String x:Key="Screens.Editor.NoDeadline">No deadline</sys:String>
    <sys:String x:Key="Screens.Editor.StartsAfter">Starts after</sys:String>
    <sys:String x:Key="Screens.Editor.StartsAfterNone">(starts right away)</sys:String>
    <sys:String x:Key="Screens.Editor.Color">Color</sys:String>
    <sys:String x:Key="Screens.Editor.Checklist">Checklist (optional)</sys:String>
    <sys:String x:Key="Screens.Editor.ChecklistHint">Just for you; it isn't used in the math.</sys:String>
    <sys:String x:Key="Screens.Editor.MoveUp">Move up</sys:String>
    <sys:String x:Key="Screens.Editor.MoveDown">Move down</sys:String>
    <sys:String x:Key="Screens.Editor.PreviewTitle">How it will go</sys:String>
    <sys:String x:Key="Screens.Editor.Preview.Incomplete">Fill in the details to see how the plan will go.</sys:String>
