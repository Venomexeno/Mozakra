    <sys:String x:Key="Screens.Settings.ImportDone">Data imported.</sys:String>
    <sys:String x:Key="Screens.Settings.ImportFailed">Couldn't import: {0}</sys:String>
    <sys:String x:Key="Screens.Settings.ImportError.None">Something went wrong.</sys:String>
    <sys:String x:Key="Screens.Settings.ImportError.FileNotFound">The file wasn't found.</sys:String>
