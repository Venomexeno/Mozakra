    <sys:String x:Key="Screens.FreeTime.To">To</sys:String>
    <sys:String x:Key="Screens.FreeTime.MinutesPerDay">min/day</sys:String>
    <sys:String x:Key="Screens.FreeTime.Label.Vacation">Vacation</sys:String>
    <sys:String x:Key="Screens.FreeTime.Label.FreeDay">Free day</sys:String>
    <sys:String x:Key="Screens.FreeTime.Label.BusyDay">Busy day</sys:String>
    <sys:String x:Key="Screens.FreeTime.Error.Dates">Pick both dates for every range.</sys:String>
    <sys:String x:Key="Screens.FreeTime.Error.Range">The end date must be on or after the start date.</sys:String>
    <sys:String x:Key="Screens.FreeTime.Error.Minutes">Minutes must be between 0 and 1440.</sys:String>
    <sys:String x:Key="Screens.FreeTime.Error.Reminder">The reminder for {0} isn't a time (write it like 20:30).</sys:String>

