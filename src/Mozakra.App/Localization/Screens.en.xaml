<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Plans, plan editor, free time, settings, onboarding (Plan 06). Keys must match Screens.ar.xaml. -->

    <!-- Kind -->
    <sys:String x:Key="Screens.Kind.Course">Course</sys:String>
    <sys:String x:Key="Screens.Kind.Work">Work / project</sys:String>

