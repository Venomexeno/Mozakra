    <sys:String x:Key="Screens.Settings.DataHint">Everything stays on this PC. A backup is made automatically every day.</sys:String>
    <sys:String x:Key="Screens.Settings.Export">Export…</sys:String>
    <sys:String x:Key="Screens.Settings.Import">Import…</sys:String>
