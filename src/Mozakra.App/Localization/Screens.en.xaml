    <sys:String x:Key="Screens.Settings.ImportError.MissingPlanReference">The file is incomplete: it refers to a plan that isn't in it.</sys:String>
    <sys:String x:Key="Screens.Settings.Updates">Updates</sys:String>
    <sys:String x:Key="Screens.Settings.CheckUpdates">Check for updates</sys:String>
    <sys:String x:Key="Screens.Settings.UpdatesChecking">Checking…</sys:String>
    <sys:String x:Key="Screens.Settings.UpdateReady">An update was downloaded; it installs when you exit.</sys:String>
