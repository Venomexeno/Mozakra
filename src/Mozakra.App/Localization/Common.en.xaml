<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Shared strings (Plan 04). Keys must match Common.ar.xaml. -->

    <!-- App -->
    <sys:String x:Key="Common.AppName">Mozakra</sys:String>
    <sys:String x:Key="Common.Tagline">Study for your future</sys:String>
    <sys:String x:Key="Common.TrayTooltip">Mozakra: study for your future</sys:String>

    <!-- Tray -->
    <sys:String x:Key="Common.Show">Show the note</sys:String>
    <sys:String x:Key="Common.Hide">Hide</sys:String>
    <sys:String x:Key="Common.StartWithWindows">Start with Windows</sys:String>
    <sys:String x:Key="Common.Exit">Exit</sys:String>

    <!-- Generic actions -->
    <sys:String x:Key="Common.OK">OK</sys:String>
    <sys:String x:Key="Common.Cancel">Cancel</sys:String>
    <sys:String x:Key="Common.Yes">Yes</sys:String>
    <sys:String x:Key="Common.No">No</sys:String>
    <sys:String x:Key="Common.Save">Save</sys:String>
    <sys:String x:Key="Common.Delete">Delete</sys:String>
    <sys:String x:Key="Common.Edit">Edit</sys:String>
    <sys:String x:Key="Common.Add">Add</sys:String>
    <sys:String x:Key="Common.Close">Close</sys:String>
    <sys:String x:Key="Common.Back">Back</sys:String>
    <sys:String x:Key="Common.Next">Next</sys:String>
    <sys:String x:Key="Common.Skip">Skip</sys:String>
    <sys:String x:Key="Common.Done">Done</sys:String>
    <sys:String x:Key="Common.Undo">Undo</sys:String>

    <!-- Units: use with Loc.T(key, value) -->
    <sys:String x:Key="Common.MinutesFormat">{0} min</sys:String>
    <sys:String x:Key="Common.HoursFormat">{0} h</sys:String>
    <sys:String x:Key="Common.HoursMinutesFormat">{0} h {1} min</sys:String>
    <sys:String x:Key="Common.VideosFormat">{0} videos</sys:String>

</ResourceDictionary>
