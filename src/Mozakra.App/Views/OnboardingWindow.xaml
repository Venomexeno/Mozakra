<Window x:Class="Mozakra.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mozakra.App.Views"
        Title="{DynamicResource Screens.Onboarding.Title}"
        Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="760" Height="740" MinWidth="640" MinHeight="480"
        Background="{StaticResource Paper}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="BigChoice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="200" Height="110" CornerRadius="18" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource Line}" BorderThickness="2" Effect="{StaticResource SoftShadow}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,14">
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Small}" />
            <TextBlock Text="{DynamicResource Screens.Onboarding.Welcome}" Style="{StaticResource Title}" FontSize="22" />
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="{DynamicResource Common.Back}" Command="{Binding BackCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Screens.Onboarding.SkipPlan}" Command="{Binding SkipCommand}"
                        Visibility="{Binding IsPlanStep, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{DynamicResource Screens.Onboarding.Finish}" Command="{Binding FinishCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding IsPlanStep, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{DynamicResource Common.Next}" Command="{Binding NextCommand}" Style="{StaticResource AccentButton}"
                        Visibility="{Binding IsNotPlanStep, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0" />
        </DockPanel>

        <Grid>
            <!-- Step 1: language -->
            <StackPanel Visibility="{Binding IsLanguageStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource Screens.Onboarding.LanguageTitle}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,4" />
                <TextBlock Text="{DynamicResource Screens.Onboarding.LanguageHint}" Style="{StaticResource Small}" Margin="2,0,0,16" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="WizardLanguage" Style="{StaticResource BigChoice}" Content="العربية" IsChecked="{Binding IsArabic}" />
                    <RadioButton GroupName="WizardLanguage" Style="{StaticResource BigChoice}" Content="English" IsChecked="{Binding IsEnglish}" />
                </StackPanel>
            </StackPanel>

            <!-- Step 2: free time -->
            <DockPanel Visibility="{Binding IsFreeTimeStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <TextBlock Text="{DynamicResource Screens.Onboarding.FreeTimeTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Screens.Onboarding.FreeTimeHint}" Style="{StaticResource Small}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:FreeTimeWeekView DataContext="{Binding Week}" />
                </ScrollViewer>
            </DockPanel>

            <!-- Step 3: first plan -->
            <DockPanel Visibility="{Binding IsPlanStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <TextBlock Text="{DynamicResource Screens.Onboarding.PlanTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Screens.Onboarding.PlanHint}" Style="{StaticResource Small}" />
                </StackPanel>
                <views:PlanEditorView DataContext="{Binding Editor}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
