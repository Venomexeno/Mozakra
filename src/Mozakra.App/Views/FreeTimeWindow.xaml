<Window x:Class="Mozakra.App.Views.FreeTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mozakra.App.ViewModels"
        xmlns:views="clr-namespace:Mozakra.App.Views"
        Title="{DynamicResource Screens.FreeTime.Title}"
        Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="760" Height="760" MinWidth="640" MinHeight="460"
        Background="{StaticResource Paper}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Screens.FreeTime.Title}" Style="{StaticResource Title}" Margin="2,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Screens.FreeTime.Intro}" Style="{StaticResource Small}" Margin="2,0,0,10" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Click="OnCancel" />
                <Button Content="{DynamicResource Common.Save}" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:FreeTimeWeekView DataContext="{Binding Week}" />

                <!-- Exceptions -->
                <DockPanel Margin="2,18,2,6">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Screens.FreeTime.AddException}" Command="{Binding AddExceptionCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Screens.FreeTime.Exceptions}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{DynamicResource Screens.FreeTime.ExceptionsHint}" Style="{StaticResource Small}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{DynamicResource Screens.FreeTime.NoExceptions}" Margin="4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExceptions}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Exceptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FreeTimeExceptionViewModel}">
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="2,0,2,8">
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding Labels}" SelectedItem="{Binding SelectedLabel}" DisplayMemberPath="Display"
                                              Width="130" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Screens.FreeTime.From}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <DatePicker SelectedDate="{Binding From}" Width="130" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Screens.FreeTime.To}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <DatePicker SelectedDate="{Binding To}" Width="130" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,3,3,3" />
                                    <TextBlock Text="{DynamicResource Screens.FreeTime.MinutesPerDay}" VerticalAlignment="Center" />
                                    <Button Content="✕" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="{DynamicResource Common.Delete}"
                                            Command="{Binding DataContext.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </WrapPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
