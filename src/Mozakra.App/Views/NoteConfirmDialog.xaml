<Window x:Class="Mozakra.App.Views.NoteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Common.AppName}" Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource OnNoteButton}" />
    </Window.Resources>
    <Border Style="{StaticResource StickyCard}" Margin="16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Common.AppName}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="MessageText" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,12" LineHeight="22" />
            <UniformGrid Columns="2">
                <Button Style="{StaticResource AccentButton}" IsDefault="True" Click="OnYes">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="{DynamicResource Common.Yes}" />
                </Button>
                <Button Content="{DynamicResource Common.No}" IsCancel="True" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
