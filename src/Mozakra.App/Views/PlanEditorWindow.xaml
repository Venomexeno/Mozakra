<Window x:Class="Mozakra.App.Views.PlanEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mozakra.App.Views"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="640" Height="760" MinWidth="560" MinHeight="420"
        Background="{StaticResource Paper}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Title}" Margin="2,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Click="OnCancel" />
            <Button Content="{DynamicResource Common.Save}" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
        </StackPanel>
        <views:PlanEditorView />
    </DockPanel>
</Window>
