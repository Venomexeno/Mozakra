<UserControl x:Class="Mozakra.App.Views.FreeTimeWeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mozakra.App.ViewModels"
             FontFamily="{StaticResource AppFont}">
    <!-- Presets + the 7 weekdays + weekly total (DataContext = FreeTimeWeekViewModel). Used by the free time window and the wizard. -->
    <StackPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Screens.FreeTime.Presets}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Screens.FreeTime.Preset.Student}" Command="{Binding ApplyPresetCommand}" CommandParameter="Student" />
                <Button Content="{DynamicResource Screens.FreeTime.Preset.Employee}" Command="{Binding ApplyPresetCommand}" CommandParameter="Employee" />
                <Button Content="{DynamicResource Screens.FreeTime.Preset.Freelancer}" Command="{Binding ApplyPresetCommand}" CommandParameter="Freelancer" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="{DynamicResource Screens.FreeTime.PresetsHint}" Style="{StaticResource Small}" Margin="0,0,0,8" />

        <Border Style="{StaticResource Card}" Padding="14,8" Margin="2,0">
            <StackPanel>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Screens.FreeTime.MinutesHeader}" Style="{StaticResource Small}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Small}">
                        <Run Text="{DynamicResource Screens.FreeTime.Reminder}" />
                        <Run Text="{DynamicResource Screens.FreeTime.ComingSoon}" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                </Grid>
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FreeTimeDayViewModel}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="960" TickFrequency="15" IsSnapToTickEnabled="True"
                                        SmallChange="15" LargeChange="60" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Value="{Binding Minutes}" />
                                <TextBox Grid.Column="2" Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource Small}"
                                           VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Column="4" Text="{Binding ReminderText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Screens.FreeTime.ReminderHint}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" Margin="4,8,0,0" />
    </StackPanel>
</UserControl>
