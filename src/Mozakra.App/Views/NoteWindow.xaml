<Window x:Class="Mozakra.App.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Mozakra.App.Views"
        Title="{DynamicResource Common.AppName}"
        Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource OnNoteButton}" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <!-- The root margin leaves room for the shadow and the "stuck" shake (NoteAnimator rotates this element). -->
    <Grid Margin="16">
        <Border Style="{StaticResource StickyCard}" Padding="16,14,16,12"
                MouseLeftButtonDown="OnCardMouseDown">
            <StackPanel>
                <!-- Header: date + hide -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="−" Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Common.Hide}" Command="{Binding HideCommand}" />
                    <TextBlock Text="{Binding DateText, StringFormat='📌 {0}'}" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding NudgeText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,8,0,8" LineHeight="22"
                           Visibility="{Binding NudgeText, Converter={x:Static v:NoteVisibilityConverter.Instance}}" />

                <v:NoteAgendaView />
                <v:NoteWarningsView />
                <v:NoteManualLogView Visibility="{Binding HasNoPlans, Converter={x:Static v:NoteVisibilityConverter.Instance}, ConverterParameter=Invert}" />

                <!-- Toast (click to dismiss) -->
                <Border Background="{StaticResource Ink}" CornerRadius="14" Padding="14,10" Margin="0,10,0,0"
                        Cursor="Hand" MouseLeftButtonUp="OnToastClick"
                        Visibility="{Binding IsToastVisible, Converter={x:Static v:NoteVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" TextWrapping="Wrap" LineHeight="21" />
                </Border>

                <!-- Streak + toggles -->
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{DynamicResource Note.UndoButton}" Style="{StaticResource IconButton}"
                                Command="{Binding UndoCommand}" ToolTip="{Binding UndoTooltip}"
                                Visibility="{Binding CanUndo, Converter={x:Static v:NoteVisibilityConverter.Instance}}" />
                        <Button Content="{DynamicResource Note.DetailsButton}" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleDetailsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StreakText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <v:NoteDetailsView Visibility="{Binding ShowDetails, Converter={x:Static v:NoteVisibilityConverter.Instance}}" />

                <!-- Navigation -->
                <UniformGrid Columns="3" Margin="0,10,0,0">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource OnNoteButton}">
                            <Setter Property="Padding" Value="4,7" />
                        </Style>
                    </UniformGrid.Resources>
                    <Button Content="{DynamicResource Note.NavPlans}" Command="{Binding OpenPlansCommand}" />
                    <Button Content="{DynamicResource Note.NavFreeTime}" Command="{Binding OpenFreeTimeCommand}" />
                    <Button Content="{DynamicResource Note.NavSettings}" Command="{Binding OpenSettingsCommand}" />
                </UniformGrid>
            </StackPanel>
        </Border>
        <!-- Tape strip, like the old Study Note -->
        <Rectangle Width="78" Height="20" RadiusX="3" RadiusY="3" Fill="#B3FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Center"
                   Margin="0,-10,0,0" IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-2" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</Window>
