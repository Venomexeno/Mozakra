<Window x:Class="Mozakra.App.Views.Dialogs.EditDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Common.AppName}" Icon="pack://application:,,,/Mozakra;component/Assets/mozakra.ico"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource OnNoteButton}" />
    </Window.Resources>
    <Border Style="{StaticResource StickyCard}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Note.EditDay.Hint}" Style="{StaticResource Small}" Margin="0,2,0,8" />
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Width="70"
                                     Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" />
                            <Ellipse Width="9" Height="9" Fill="{Binding ColorHex}" Stroke="#40000000" StrokeThickness="1"
                                     Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" Style="{StaticResource Small}"
                       Visibility="Collapsed" Text="{DynamicResource Note.EditDay.Invalid}" />
            <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="{DynamicResource Common.Save}" />
                </Button>
                <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
